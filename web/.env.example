# Copy to .env.local and fill. Local Supabase keys are printed by `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_PASSWORD=change-me

# Local email → Supabase Inbucket (inbox UI at http://127.0.0.1:54324)
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_FROM=kardio.az <randevu@kardio.az>

# Daily.co — leave empty for a mock room; add the API key for real video
DAILY_API_KEY=
