{
  "mcpServers": {
    "gsc": {
      "command": "node",
      "args": [
        "tools/gsc-mcp/index.mjs"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "C:/Users/User/.secrets/kardio-gsc.json",
        "GSC_SITE_URL": "sc-domain:kardio.az",
        "GSC_READONLY": "0"
      }
    }
  }
}
